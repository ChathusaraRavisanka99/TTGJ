# Database — Supabase Postgres.
# DATABASE_URL: the pooled (PgBouncer transaction mode) connection string
#   from Supabase's dashboard → Connect → Shared pooler. Keep `pgbouncer=true`
#   — it disables Prisma's prepared statements, which transaction-mode
#   poolers don't support. If the password has special characters,
#   percent-encode them (e.g. `$` -> `%24`).
# DIRECT_URL: the *non-pooled* connection (same dashboard, "Direct connection"
#   / port 5432, host `db.<project-ref>.supabase.co`). Prisma Migrate needs
#   this — DDL and advisory locks don't work reliably through the pooler.
#
# Local Docker Postgres also still works if you'd rather not depend on a
# hosted DB for dev — see docker-compose.yml — in which case both vars can
# just point at that (no pooler, so DIRECT_URL == DATABASE_URL):
#   DATABASE_URL="postgresql://ratnavue:ratnavue@localhost:5433/ratnavue?schema=public"
#   DIRECT_URL="postgresql://ratnavue:ratnavue@localhost:5433/ratnavue?schema=public"
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Supabase Storage — used by src/lib/media.ts for every upload (gem/jewelry
# photos, About/Home page builder images, lab logos, gemstone certificates).
# Real persistent storage rather than local disk, so an upload works the
# same way in local dev and on a deployed host — a serverless host's
# filesystem is ephemeral and not shared across instances, so local disk
# alone would silently break or lose files once deployed.
# SUPABASE_URL: Supabase dashboard → Settings → API → Project URL
#   (https://<project-ref>.supabase.co) — same project as DATABASE_URL above.
# SUPABASE_SERVICE_ROLE_KEY: same page → service_role key (NOT anon/public).
#   Bypasses Row Level Security — server-only, never expose to the client or
#   prefix with NEXT_PUBLIC_.
# Bucket: a "media" bucket, public read, is created automatically on first
# upload if it doesn't already exist (see src/lib/supabase.ts).
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"

# Google OAuth (leave blank to disable Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Seeded admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@ratnavue.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="ChangeMe123!"
