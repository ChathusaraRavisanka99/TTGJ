# Database — Supabase Postgres.
# DATABASE_URL: the pooled (PgBouncer transaction mode) connection string
#   from Supabase's dashboard → Connect → Shared pooler. Keep `pgbouncer=true`
#   — it disables Prisma's prepared statements, which transaction-mode
#   poolers don't support. If the password has special characters,
#   percent-encode them (e.g. `$` -> `%24`).
# DIRECT_URL: the *non-pooled* connection (same dashboard, "Direct connection"
#   / port 5432, host `db.<project-ref>.supabase.co`). Prisma Migrate needs
#   this — DDL and advisory locks don't work reliably through the pooler.
#
# Local Docker Postgres also still works if you'd rather not depend on a
# hosted DB for dev — see docker-compose.yml — in which case both vars can
# just point at that (no pooler, so DIRECT_URL == DATABASE_URL):
#   DATABASE_URL="postgresql://ratnavue:ratnavue@localhost:5433/ratnavue?schema=public"
#   DIRECT_URL="postgresql://ratnavue:ratnavue@localhost:5433/ratnavue?schema=public"
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"

# NextAuth
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_URL="http://localhost:3000"

# Supabase Storage (S3-compatible protocol) — used by src/lib/media.ts for
# every upload (gem/jewelry photos, About/Home page builder images, lab
# logos, gemstone certificates). Real persistent storage rather than local
# disk alone, so uploads survive a redeploy/new instance — a serverless
# host's filesystem is ephemeral and not shared across instances. Can be a
# different Supabase project than DATABASE_URL above — storage and
# database are independent.
# SUPABASE_STORAGE_ENDPOINT / _REGION / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY:
#   Supabase dashboard → Storage → S3 Connection. These are full-access,
#   RLS-bypassing credentials — server-only, never expose to the client or
#   prefix with NEXT_PUBLIC_.
# Bucket: a "media" bucket is created automatically on first upload if it
# doesn't already exist (see src/lib/media.ts) and is left private — every
# read goes through our own /media/[filename] route (using these same
# credentials), never a direct Supabase Storage URL, so there's no
# dashboard "Public bucket" step needed.
# Local caching: every upload/read is also mirrored to a local .media-cache/
# directory (gitignored) so repeat reads are instant and a Storage hiccup
# doesn't break already-cached files — see src/lib/media-cache.ts. Storage
# stays the source of truth; a fresh instance with an empty cache just
# refetches from Storage on first read.
SUPABASE_STORAGE_ENDPOINT="https://your-project-ref.storage.supabase.co/storage/v1/s3"
SUPABASE_STORAGE_REGION="your-region"
SUPABASE_STORAGE_ACCESS_KEY_ID="replace-with-your-s3-access-key-id"
SUPABASE_STORAGE_SECRET_ACCESS_KEY="replace-with-your-s3-secret-access-key"

# Google OAuth (leave blank to disable Google sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# PayHere — Sri Lanka's payment gateway, used for retail checkout (see
# src/lib/payhere.ts, src/actions/checkout.ts). Supports both LKR (local)
# and USD/EUR/GBP/AUD (international cards) through one merchant account —
# Stripe doesn't support Sri Lanka-registered merchants at all.
# PAYHERE_MERCHANT_ID / PAYHERE_MERCHANT_SECRET: PayHere dashboard →
#   Integrations → your domain's "Merchant ID" and "Merchant Secret".
#   Use your sandbox account's credentials here for testing — sandbox and
#   live use different Merchant IDs/Secrets.
# PAYHERE_MODE: "sandbox" (default) or "live". Deliberately opt-in to
#   "live" — a missing/misconfigured value can never silently start
#   taking real payments.
# Note: PayHere's payment notification (notify_url) can't be tested
# against localhost — it needs a publicly reachable URL (a deployed
# preview, or a tunnel like ngrok pointed at your dev server), since
# PayHere's servers POST to it directly.
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
PAYHERE_MODE="sandbox"

# Seeded admin account (used by prisma/seed.ts)
SEED_ADMIN_EMAIL="admin@ratnavue.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="ChangeMe123!"
