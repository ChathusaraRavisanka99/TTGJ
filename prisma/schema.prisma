generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Non-pooled connection Prisma Migrate uses for DDL/advisory locks —
  // DATABASE_URL is the PgBouncer transaction-mode pooler, which doesn't
  // support those reliably.
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  quoteRequests   QuoteRequest[]
  sourcingRequest SourcingRequest[]
  invoices        Invoice[]
  carts           Cart[]
  cartInvoices    CartInvoice[]
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Master data ----------

model Mineral {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  hueMin      Int
  hueMax      Int
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  gemstones Gemstone[]
}

enum CutCategory {
  FACETED
  CABOCHON
}

model Cut {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  category  CutCategory
  active    Boolean     @default(true)
  sortOrder Int         @default(0)

  gemstones Gemstone[]
}

model ClarityGrade {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  gemstones Gemstone[]
}

model Treatment {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

model Origin {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  isCeylon  Boolean @default(false)
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

model CertificationLab {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  // Optional online report-verification URL. Contains the literal token
  // `{certId}`, which the storefront substitutes with the gemstone's
  // certReportNumber to build a "Verify Certificate" link — e.g.
  // "https://www.gia.edu/report-check?reportno={certId}". Left blank for
  // labs with no public lookup tool.
  verifyUrlTemplate String?
  websiteUrl        String?
  // Uploaded via the same Supabase Storage upload path as everything else
  // in src/lib/media.ts, not a MediaAsset row — it belongs to the lab
  // itself, not to any one gemstone's gallery.
  logoUrl           String?

  active    Boolean @default(true)
  sortOrder Int     @default(0)

  gemstones Gemstone[]
}

// ---------- Catalog ----------

enum StockStatus {
  AVAILABLE
  RESERVED
  SOLD
}

model Gemstone {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  mineralId String
  mineral   Mineral @relation(fields: [mineralId], references: [id])
  variety   String?

  cutId String
  cut   Cut    @relation(fields: [cutId], references: [id])

  caratWeight Float
  lengthMm    Float?
  widthMm     Float?
  depthMm     Float?

  // Configurator-compatible color spec (HSL)
  colorHue        Int
  colorSaturation Int     @default(70)
  colorLightness  Int     @default(50)
  colorLabel      String?

  clarityGradeId String
  clarityGrade   ClarityGrade @relation(fields: [clarityGradeId], references: [id])

  treatmentId String
  treatment   Treatment @relation(fields: [treatmentId], references: [id])

  originId String
  origin   Origin @relation(fields: [originId], references: [id])

  symmetryNotes String?
  polishNotes   String?

  certLabId        String?
  certLab          CertificationLab? @relation(fields: [certLabId], references: [id], onDelete: SetNull)
  certReportNumber String?
  certFileUrl      String?

  // Price is opt-in per item: admins set it and separately choose whether
  // it's shown publicly, or kept as an internal reference for quoting.
  // Defaults keep every existing/new item exactly as before (quote-only,
  // no price shown) until an admin explicitly turns showPrice on.
  price     Float?
  showPrice Boolean @default(false)

  stockStatus StockStatus @default(AVAILABLE)
  isPublished Boolean     @default(true)

  // Curated by admins for the homepage's Featured Gemstones section
  // (independent of isPublished — a piece can be published but not
  // featured). The section itself can be switched off entirely via
  // HomeContent.showFeaturedGems without touching any item's flag.
  isFeatured Boolean @default(false)

  media MediaAsset[]

  quoteRequests       QuoteRequest[]
  jewelryGemstoneLink JewelryGemstoneLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mineralId])
  @@index([cutId])
  @@index([stockStatus])
  @@index([isFeatured])
}

enum PieceType {
  RING
  NECKLACE
  EARRINGS
  BRACELET
  PENDANT
  BROOCH
  OTHER
}

enum MetalType {
  GOLD
  WHITE_GOLD
  ROSE_GOLD
  PLATINUM
  SILVER
}

model JewelryPiece {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String? @db.Text

  pieceType    PieceType
  metalType    MetalType
  metalPurity  String?
  metalWeightG Float?
  ringSize     String?
  styleTags    String[]

  price     Float?
  showPrice Boolean @default(false)

  stockStatus StockStatus @default(AVAILABLE)
  isPublished Boolean     @default(true)

  // Same curation flag as Gemstone.isFeatured, for the homepage's
  // Featured Jewelry section.
  isFeatured Boolean @default(false)

  media     MediaAsset[]
  gemstones JewelryGemstoneLink[]

  quoteRequests QuoteRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pieceType])
  @@index([stockStatus])
  @@index([isFeatured])
}

model JewelryGemstoneLink {
  id           String       @id @default(cuid())
  jewelryId    String
  jewelry      JewelryPiece @relation(fields: [jewelryId], references: [id], onDelete: Cascade)
  gemstoneId   String?
  gemstone     Gemstone?    @relation(fields: [gemstoneId], references: [id])
  freeformDesc String?

  @@index([jewelryId])
}

enum MediaType {
  IMAGE
  VIDEO
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String
  type      MediaType
  altText   String?
  isPrimary Boolean   @default(false)
  sortOrder Int       @default(0)

  gemstoneId String?
  gemstone   Gemstone? @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  jewelryId String?
  jewelry   JewelryPiece? @relation(fields: [jewelryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([gemstoneId])
  @@index([jewelryId])
}

// ---------- Site content (admin-editable marketing copy) ----------

// One row per editable page ("home", "about", ...). `data` is a loosely-typed
// JSON blob whose shape is owned by the corresponding TS type in
// src/lib/page-content.ts — deliberately not a rigid column-per-field model,
// since marketing copy/images change shape more often than catalog data.
// Missing keys fall back to that page's DEFAULT_*_CONTENT constant, so old
// rows stay valid after new fields are added in code.
model PageContent {
  id        String   @id @default(cuid())
  page      String   @unique
  data      Json
  updatedAt DateTime @updatedAt
}

// ---------- Quotes & sourcing ----------

enum QuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ProductType {
  GEMSTONE
  JEWELRY
}

model QuoteRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  productType ProductType?
  gemstoneId  String?
  gemstone    Gemstone?     @relation(fields: [gemstoneId], references: [id])
  jewelryId   String?
  jewelry     JewelryPiece? @relation(fields: [jewelryId], references: [id])

  // Present when the request originated from the standalone configurator
  // rather than an existing catalog item.
  configuredSpec Json?

  quantity Int     @default(1)
  note     String? @db.Text

  noteFlaggedForPrice Boolean @default(false)
  adminNotes          String? @db.Text

  status QuoteStatus @default(SUBMITTED)

  // Set by the admin alongside (or before) moving status to QUOTED. A flat
  // total for the requested quantity, not a per-unit price — this business
  // is quote-only with one line item per request, so a fuller line-item
  // breakdown would be more structure than the data actually needs.
  quotedPrice     Float?
  quoteValidUntil DateTime?
  quotedAt        DateTime?

  // Created automatically the moment status is set to ACCEPTED (see
  // updateQuoteRequest) — never created directly. A quote can have at most
  // one invoice.
  invoice Invoice?

  // Same moment an Invoice is created — also added as a line item to the
  // customer's open Cart (see ensureCartItemForQuote). The two aren't
  // redundant: Invoice is a per-quote historical record; CartItem is what
  // actually lets several accepted quotes/sourcing requests be reviewed
  // and submitted for payment together.
  cartItem CartItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model Invoice {
  id            String @id @default(cuid())
  // Sequential per calendar year, e.g. "INV-2026-0007" — generated in
  // createInvoiceForQuote from a count of that year's existing invoices.
  invoiceNumber String @unique

  quoteRequestId String       @unique
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshotted from QuoteRequest.quotedPrice at the moment of acceptance,
  // deliberately not read live off the quote — an invoice is a historical
  // record and shouldn't silently change if the quote is edited afterward.
  amount   Float
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
}

model SourcingRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  mineralDescription String
  approxSize         String?
  approxCut          String?
  approxColor        String?
  notes              String? @db.Text

  noteFlaggedForPrice Boolean @default(false)
  adminNotes          String? @db.Text

  status QuoteStatus @default(SUBMITTED)

  // Mirrors QuoteRequest's own pricing fields — a sourcing request becomes
  // priceable the same way a quote does, so it can generate a CartItem the
  // same way once accepted (see updateSourcingRequest).
  quotedPrice     Float?
  quoteValidUntil DateTime?
  quotedAt        DateTime?

  // Added to the customer's open Cart the moment status is set to
  // ACCEPTED — see ensureCartItemForSourcing.
  cartItem CartItem?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------- Cart & payment ----------
//
// A customer has at most one OPEN cart at a time (enforced in
// lib/cart.ts's getOrCreateOpenCart, not by a DB constraint — Prisma has
// no partial/conditional unique index, and this app has no concurrent-
// request risk worth one). Accepting a quote or sourcing request (see
// updateQuoteRequest/updateSourcingRequest in actions/admin-requests.ts)
// adds a CartItem to that open cart automatically. The customer reviews
// their cart and submits it (OPEN -> SUBMITTED) when ready to pay by wire
// transfer; submitting starts a fresh OPEN cart for anything accepted
// afterward. Payment itself happens outside the app (a bank wire) — an
// admin flips paymentStatus to PAID once it's confirmed received.

enum CartStatus {
  OPEN
  SUBMITTED
}

enum PaymentStatus {
  AWAITING_PAYMENT
  PAID
}

model Cart {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status        CartStatus    @default(OPEN)
  paymentStatus PaymentStatus @default(AWAITING_PAYMENT)

  submittedAt DateTime?
  // Set when an admin marks paymentStatus PAID — see markCartPaid.
  paidAt      DateTime?

  // Snapshotted from DiscountCode.amountOff at the moment the code is
  // applied (see applyDiscountCode) — same "historical record, doesn't
  // silently change later" reasoning every other amount field in this
  // schema already uses. Null means no code is applied. The cart total is
  // sum(items.amount) - discountAmount, floored at 0 rather than allowing
  // a code larger than the cart to go negative.
  discountAmount Float?

  items        CartItem[]
  invoice      CartInvoice?
  discountCode DiscountCode?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  // Exactly one of these two is set — a cart item always originates from
  // an accepted QuoteRequest or an accepted SourcingRequest, never both
  // and never neither.
  quoteRequestId String?       @unique
  quoteRequest   QuoteRequest? @relation(fields: [quoteRequestId], references: [id])

  sourcingRequestId String?          @unique
  sourcingRequest   SourcingRequest? @relation(fields: [sourcingRequestId], references: [id])

  // Snapshotted at the moment the item was added — same "historical
  // record, doesn't silently change later" reasoning Invoice.amount
  // already uses.
  label  String
  amount Float

  createdAt DateTime @default(now())

  @@index([cartId])
}

model CartInvoice {
  id            String @id @default(cuid())
  // Sequential per calendar year, distinct prefix from the older
  // per-quote Invoice ("INV-2026-...") so the two are never visually
  // confusable — this document can cover several quotes/sourcing
  // requests at once, that one never does.
  invoiceNumber String @unique

  cartId String @unique
  cart   Cart   @relation(fields: [cartId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Snapshotted sum of the cart's items (less any applied discount,
  // floored at 0) at generation time.
  amount   Float
  issuedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId])
}

// One-time-use, fixed-amount-off discount codes. Generated by an admin
// (see actions/discount-codes.ts) with no code tied to any customer in
// advance — the first cart to redeem one consumes it, full stop. A
// percentage-off model isn't supported; per the brief, this is "one time
// use by amount" only.
model DiscountCode {
  id   String @id @default(cuid())
  // Stored and matched uppercase — codes are case-insensitive from a
  // customer's point of view (see lib/discount-codes.ts's normalizeCode).
  code String @unique

  amountOff Float

  // Set together the moment a customer successfully applies this code to
  // their open cart (see applyDiscountCode) — both null until then. A
  // code can be released back to unused by removing it from a cart that
  // hasn't been submitted yet (removeDiscountCode), which clears both.
  cartId String?   @unique
  cart   Cart?     @relation(fields: [cartId], references: [id])
  usedAt DateTime?

  createdAt DateTime @default(now())

  @@index([code])
}
